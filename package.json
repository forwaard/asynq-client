{
  "name": "asynq-node",
  "version": "0.1.0",
  "description": "Insert-only Node.js/TypeScript producer for the Go asynq task queue (Redis wire-compatible)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit.test.ts",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forwaard/asynq-node.git"
  },
  "keywords": [
    "asynq",
    "task-queue",
    "redis",
    "producer",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/forwaard/asynq-node/issues"
  },
  "homepage": "https://github.com/forwaard/asynq-node#readme",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "ioredis": "^6.0.0",
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
